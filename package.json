    "start": "node bin/mcp-web.js serve"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "bin": {
    "mcp-web": "bin/mcp-web.js"
  },
  "dependencies": {
    "jsdom": "^30.1.1",
    "linkedom": "^0.18.0",
    "pureimage": "^0.4.20"
  }
}
