{
  "name": "mcp-web",
  "version": "1.2.0",
  "description": "MCP server web automation untuk Termux — engine ganda: DOM ringan (linkedom) atau JS hidup (jsdom, tanpa Chromium/adb).",
  "directories": {
    "test": "tests"
  },
  "scripts": {
